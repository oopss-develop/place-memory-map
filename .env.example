# Copy this file to .env.local and replace every <...> placeholder.
# .env.local is ignored by Git. Never commit its real secrets.

# Public browser configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=<supabase-project-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=<kakao-javascript-key>

# false: real Supabase login and shared data / true: browser-only demo data
NEXT_PUBLIC_DEMO_MODE=false

# Server-only configuration
KAKAO_REST_API_KEY=<kakao-rest-api-key>

# Exactly four allowed members. Use the same email in both JSON values.
ALLOWED_MEMBERS_JSON=[{"email":"<first-email>","displayName":"<first-name>"},{"email":"<second-email>","displayName":"<second-name>"},{"email":"<third-email>","displayName":"<third-name>"},{"email":"<fourth-email>","displayName":"<fourth-name>"}]
ALLOWED_MEMBER_KEYS_JSON=[{"email":"<first-email>","keyword":"<first-login-keyword>","displayName":"<first-name>"},{"email":"<second-email>","keyword":"<second-login-keyword>","displayName":"<second-name>"},{"email":"<third-email>","keyword":"<third-login-keyword>","displayName":"<third-name>"},{"email":"<fourth-email>","keyword":"<fourth-login-keyword>","displayName":"<fourth-name>"}]

# Server-only Supabase admin key. Never use NEXT_PUBLIC_ for this value.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Configure Brevo SMTP inside Supabase Auth > SMTP Settings.
# Never place SMTP credentials in NEXT_PUBLIC_* variables.
